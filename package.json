{
  "name": "prop-tax-scraper",
  "version": "0.3.55",
  "description": "Multi-county CAD property scraper with live console UI",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "bun src/server.js",
    "dev": "bun --watch src/server.js",
    "portal": "bun src/portal/server.js",
    "portal:dev": "bun --watch src/portal/server.js",
    "va:rebuild": "bun scripts/build-va-opportunities.js --rebuild --list",
    "import:bcad": "bun scripts/import-bcad-from-bucket.js",
    "scrape": "python3 scrape_neighborhoods.py",
    "prepare:cameron": "python3 scripts/prepare_cameron_bulk.py",
    "build:tx-map": "bun scripts/build-texas-map.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.0",
    "open": "^10.2.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  }
}
