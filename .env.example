# Local PostgreSQL (defaults shown)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prop_tax
DB_USER=
DB_PASSWORD=

# Or use a single URL (Railway / managed):
# DATABASE_URL=postgresql://user:pass@host:5432/prop_tax
# DATABASE_SSL=false

# Auth (required for login / JWT)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Optional admin profile fields on first bootstrap:
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User
# ADMIN_COMPANY=System

# Password-reset email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=http://localhost:3847

# Optional ops token for data restore / prepare-reimport scripts
# DATA_UPLOAD_TOKEN=
